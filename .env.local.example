# ─── Konquer Prototype — Environment Variables ────────────────────────────────
#
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is gitignored — never commit live credentials.

# Base URL of the Orchestrator service.
# When set, the prototype fetches real data from your running backend.
# When unset, the prototype uses static fallback data (prototype/demo mode).
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8011

# Set to "true" to force static fallback data regardless of ORCHESTRATOR_URL.
# Useful for frontend-only development or demo presentations.
NEXT_PUBLIC_DEMO_MODE=true

# Default org/user ID used for API calls in the prototype.
# In production this will come from the authenticated session.
NEXT_PUBLIC_DEFAULT_ORG_ID=demo

# Invite Request API (server-only — used by POST /api/request-invite). Copy from repo root .env if needed.
# Persistence table remains named `waitlist` in Supabase for backwards compatibility.
# Create table: see docs/waitlist-table.sql
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoHighLevel Inbound Webhook — fires when someone requests an invite. Optional.
# Get this URL from: GHL → Automation → Workflows → Inbound Webhook trigger.
GHL_INVITE_WEBHOOK_URL=
